{
  "name": "@calibtools/plumbline",
  "version": "0.1.0",
  "private": true,
  "description": "Free camera calibration, in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consistency": "vitest run --config vitest.consistency.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:worker": "vitest run --config vitest.browser.config.ts tests/worker-responsiveness.spec.ts",
    "test:offline": "vitest run --config vitest.browser.config.ts tests/offline.spec.ts",
    "generate:fixtures": "cd tools/reference && python3 render_synthetic.py && python3 calibrate_reference.py"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "preact": "^11.0.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
